								"key": "Authorization",
								"value": "Bearer {{supplierToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"items\": [\n        {\n            \"itemId\": \"ITEM_ID_1\",\n            \"quotedPrice\": 2.50,\n            \"quantity\": 10000\n        },\n        {\n            \"itemId\": \"ITEM_ID_2\",\n            \"quotedPrice\": 1.75,\n            \"quantity\": 5000\n        }\n    ],\n    \"totalQuotePrice\": 35000,\n    \"deliveryTimeframe\": \"4-6 weeks\",\n    \"additionalNotes\": \"Bulk order discount applied\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:5000/api/rfq/:id/negotiate",
							"host": [
								"http://localhost:5000"
							],
							"path": [
								"api",
								"rfq",
								":id",
								"negotiate"
							],
							"variable": [
								{
									"key": "id",
									"value": "RFQ_ID_HERE"
								}
							]
						}
					},
					"response": []
				},
