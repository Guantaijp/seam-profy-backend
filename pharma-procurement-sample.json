					},
					"response": []
				},
				{
					"name": "Publish RFQ",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{healthFacilityToken}}",
								"type": "text"
							}
						],
