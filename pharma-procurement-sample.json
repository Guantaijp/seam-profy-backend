								},
								{
									"key": "summary",
									"value": "Urgent procurement of essential medical supplies for Q2 2024",
									"type": "text"
								},
								{
                                    "key": "items",
                                    "value": "[{\"name\": \"Surgical Masks\", \"quantity\": 10000, \"description\": \"High-quality disposable surgical masks\"}, {\"name\": \"Latex Gloves\", \"quantity\": 5000, \"description\": \"Medium-sized latex examination gloves\"}]",
                                    "type": "text"
